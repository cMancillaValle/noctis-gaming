# ====================================================================
# Noctis Gaming - Plantilla de Variables de Entorno (.env.example)
# ====================================================================
# INSTRUCCIONES:
# 1. Copia este archivo a un archivo '.env' en la raíz del proyecto:
#    cp .env.example .env
# 2. Reemplaza los valores de ejemplo por credenciales y secretos seguros.
# 3. El archivo '.env' está ignorado en Git y NUNCA debe publicarse.
# ====================================================================

# Base de Datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Seguridad JWT (HMAC-SHA256)
# OBLIGATORIO: Debe tener al menos 32 caracteres (256 bits) en entornos de producción.
JWT_SECRET=your_minimum_32_character_hmac_sha256_secret_key_here!

# Clave Administrativa Interna para Servicios (X-Admin-Key)
ADMIN_API_KEY=your_secure_admin_api_key_here

# Inicialización de Datos y Administración (Opcional)
NOCTIS_SEED_ENABLED=true
ADMIN_INITIAL_PASSWORD=your_secure_initial_admin_password_here

# Puertos Locales
PORT_FRONTEND=3000
PORT_CLIENTES=8081
PORT_PRODUCTOS=8082
PORT_INVENTARIO=8083
PORT_VENTAS=8084
PORT_FACTURACION=8085

# URLs de Comunicación entre Microservicios (Docker Network)
SERVICES_CLIENTES_URL=http://clientes-service:8081
SERVICES_PRODUCTOS_URL=http://productos-service:8082
SERVICES_INVENTARIO_URL=http://inventario-service:8083
SERVICES_FACTURACION_URL=http://facturacion-service:8085
